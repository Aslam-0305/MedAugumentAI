# Copy to .env. Values shown are the defaults.
STORAGE_ROOT=../storage
DB_BACKEND=mongo            # mongo | file  (file = zero-dependency JSON store for local trials)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=medaugment
# API_KEY=change-me         # when set, every /api/v1 call must send header X-API-Key
MAX_UPLOAD_MB=4096
MAX_ARCHIVE_FILES=200000
MAX_UNCOMPRESSED_MB=32768
MAX_ARCHIVE_RATIO=200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WORKER_THREADS=2
MAX_JOB_ADDITIONAL=50000
